# Notion API credentials
# Get your API key from https://www.notion.so/my-integrations
NOTION_API_KEY=

# The ID of your Projects database in Notion
# (copy from the database URL: notion.so/YOUR-WORKSPACE/DATABASE_ID?v=...)
NOTION_PROJECTS_DB_ID=

# The ID of your Anime database in Notion
NOTION_ANIME_DB_ID=

# Giscus comment widget — fill these in after creating your GitHub repo
# Get values at https://giscus.app after setting up the app on your repo
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
